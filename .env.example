LAT=52.52
LON=13.405
ALT_M=0
TZ=UTC
READSB_DEVICE_TYPE=rtlsdr

FLYSCANNER_BEAST_HOST=127.0.0.1
FLYSCANNER_BEAST_PORT=30005
FLYSCANNER_LISTEN=0.0.0.0:8080
FLYSCANNER_BEAST_OUT=0.0.0.0:30004
FLYSCANNER_DEMO=false
FLYSCANNER_AIRCRAFT_DB=data/aircraft.csv.gz
RUST_LOG=flyscanner=info

# Ultrafeeder-like outbound Beast feeds (semicolon-separated). Example:
# FLYSCANNER_CONFIG=adsb,feed.adsb.fi,30004,beast_reduce_plus_out;adsb,in.adsb.lol,30004,beast_reduce_plus_out,uuid=...
FLYSCANNER_CONFIG=
# Station UUID for beast_reduce_plus (also accepted as UUID=)
FLYSCANNER_UUID=
FLYSCANNER_BEAST_REDUCE_INTERVAL=0.5

# Feeder sidecars (deploy/docker-compose.feeders.yml — profile `feeders`)
BEASTHOST=flyscanner
BEASTPORT=30004
PIAWARE_FEEDER_ID=
FR24KEY=
ADSBX_UUID=

# Docker profile `beast` (Win/Mac/Linux without local USB SDR):
# FLYSCANNER_BEAST_HOST=host.docker.internal
